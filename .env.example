# Copy to .env (gitignored) and fill in what you need. All vars are optional;
# see README.md "Environment variables" for full descriptions and defaults.

# Real hop count between the client and this container: Cloudflare edge + nginx = 2.
# Only matters once LEAKSHEET_RATE_LIMIT_PER_MIN is enabled below.
LEAKSHEET_TRUSTED_PROXY_HOPS=2

# Shared secret for POST /api/cache/clear. Unset = endpoint disabled (fail closed).
# LEAKSHEET_ADMIN_TOKEN=

# Per-IP req/min cap on /sheet, /stream, /metadata (/image-proxy gets 10x). Unset/0 = off.
# LEAKSHEET_RATE_LIMIT_PER_MIN=60

# Extra comma-separated hosts /sheet may fetch, beyond the built-in seed + ArtistGrid feed.
# The image proxy trusts only the seed plus this list, never the feed.
# LEAKSHEET_EXTRA_SHEET_HOSTS=

# Memory-bounding concurrency knobs. Defaults suit a ~512 MB box; raise only with headroom.
# LEAKSHEET_GID_FETCH_CONCURRENCY=6
# LEAKSHEET_HUB_LOAD_CONCURRENCY=3
# LEAKSHEET_IMAGE_RESIZE_CONCURRENCY=3

# Hourly revalidation of recently used trackers. 0 disables.
# LEAKSHEET_PREWARM=1
# LEAKSHEET_PREWARM_INTERVAL=3600
# LEAKSHEET_PREWARM_BATCH=25

# Disk-cache cap for fetched sheets and parses, in bytes (default 1 GB).
# LEAKSHEET_SHEET_CACHE_MAX_BYTES=1073741824
